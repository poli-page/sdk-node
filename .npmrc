min-release-age=3
ignore-scripts=true
; typescript@7 (dependabot #20) outpaces typedoc's peer range — typedoc 0.28.x
; caps at typescript 6.0.x and no stable release lists TS7 yet, so `npm ci`
; ERESOLVEs. typedoc is docs-only (unused by the tsup/tsc build and vitest
; tests), so don't let its stale peer block install.
; Remove once typedoc ships a stable release that peers typescript 7.
legacy-peer-deps=true