# Copy this file to .env (in this same directory — the SDK repo root)
# and fill in your API key. The demos under demo/ all read from
# .env automatically — no need to set the env var or paste it interactively.
#
# Use a `sandbox` key (starts with `pp_sandbox_`) of a fresh organization:
# the demos render its `getting-started` project. Create one at:
#   https://app.poli.page/orgs/{YOUR_ORG}/keys
#
# `.env` is gitignored. This file is here only for the demos; the SDK
# itself doesn't read any environment variables at runtime.

POLI_PAGE_API_KEY=pp_sandbox_x

# Optional. The API base URL the demos (and integration tests) hit.
# Defaults to https://api.poli.page when unset.
# POLI_PAGE_BASE_URL=https://api.poli.page
